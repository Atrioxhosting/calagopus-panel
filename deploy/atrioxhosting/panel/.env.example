APP_ENCRYPTION_KEY=<generate-with-openssl-rand-hex-32>
POSTGRES_PASSWORD=<generate-with-openssl-rand-hex-32>
WEBADMIN_PASSWORD=<generate-with-openssl-rand-hex-32>
